# Serves Meerkat's web build and, on the same origin, the Meerkat config it
# loads, the GitHub API, the two programs it reads and dispatch's Meerkat config
# check. The browser holds no credential: the GitHub token comes from this
# process's environment. That
# token may be able to write, so /gh/* passes reads, passes one kind of
# write (a PUT of a single file in the config repo), and answers every other
# write with 403.
#
# Environment:
#   LISTEN         address to listen on, e.g. :8088
#   SITE_DIR       the web build (`nsh package --target web` output)
#   CONFIG_DIR     the Meerkat config directory served at /config, e.g. the
#                  checkout's config.example; read-only, never cached
#   GH_TOKEN       token sent to the GitHub API (may be able to write)
#   CONFIG_REPO    the config repo whose files the web build may save, e.g.
#                  mouriya-s-lab/meerkat-config; unset: no write is passed
#   COUNCIL_URL    the council daemon, e.g. http://127.0.0.1:7421
#   GUARDIANS_URL  the guardians program, e.g. http://127.0.0.1:7410
#   DISPATCH_URL   the omp-dispatch launcher's Meerkat config check listener,
#                  e.g. http://127.0.0.1:47593
{
	admin off
	auto_https off
}

# The one write /gh/* passes: PUT of a single file under CONFIG_REPO's contents.
# An unset CONFIG_REPO expands to "", which would let the path match
# /repos//contents/...; the leading guard keeps the matcher empty then.
# Path hygiene: no "..", "%", "//" or backslash in the decoded path.
(configWriteMatch) {
	method PUT
	path /repos/{$CONFIG_REPO}/contents/*
	expression `"{$CONFIG_REPO}" != "" && !({http.request.uri.path}.contains("..") || {http.request.uri.path}.contains("%") || {http.request.uri.path}.contains("//") || {http.request.uri.path}.contains("\\"))`
}

http://{$LISTEN} {
	handle_path /gh/* {
		# Reads go upstream. REST: GET and HEAD. GraphQL: POST /graphql whose
		# body names no mutation and has no \u escape (an escaped "mutation"
		# would otherwise pass the text check). Config writes go upstream too
		# (configWriteMatch). Anything else: 403.
		@ghWrite {
			not method GET HEAD
			not {
				method POST
				path /graphql
			}
			not {
				import configWriteMatch
			}
		}
		respond @ghWrite 403
		@ghMutation {
			method POST
			path /graphql
			expression `{http.request.body}.matches(r"(?i)mutation|\\u")`
		}
		respond @ghMutation 403

		reverse_proxy https://api.github.com {
			header_up Host api.github.com
			header_up Authorization "Bearer {env.GH_TOKEN}"
			header_up -Cookie
		}
	}

	# The Meerkat config directory, as the web build fetches it when it starts:
	# reads only, and never cached, so an edit shows on the next reload.
	# An empty CONFIG_DIR would serve the working directory: refuse it.
	handle_path /config/* {
		@notRead {
			not method GET HEAD
		}
		respond @notRead 405
		@noDir expression `"{$CONFIG_DIR}" == ""`
		respond @noDir 404
		header Cache-Control "no-store"
		root * "{$CONFIG_DIR}"
		file_server
	}

	handle_path /council/* {
		reverse_proxy {$COUNCIL_URL}
	}

	handle_path /guardians/* {
		reverse_proxy {$GUARDIANS_URL}
	}

	handle_path /dispatch/* {
		reverse_proxy {$DISPATCH_URL}
	}

	handle {
		root * "{$SITE_DIR}"
		file_server
	}
}
