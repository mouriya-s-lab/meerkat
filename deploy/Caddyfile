# Serves the dashboard's web build and, on the same origin, the GitHub API
# and the two programs it reads. The browser holds no credential: the
# GitHub token comes from this process's environment. That token may be able
# to write, so /gh/* passes only reads and answers every write with 403.
#
# Environment:
#   LISTEN         address to listen on, e.g. :8088
#   SITE_DIR       the web build (`nsh package --target web` output)
#   GH_TOKEN       token sent to the GitHub API (may be able to write)
#   COUNCIL_URL    the council daemon, e.g. http://127.0.0.1:7421
#   GUARDIANS_URL  the guardians program, e.g. http://127.0.0.1:7410
{
	admin off
	auto_https off
}

{$LISTEN} {
	handle_path /gh/* {
		# Only reads go upstream. REST: GET and HEAD. GraphQL: POST /graphql
		# whose body names no mutation and has no \u escape (an escaped
		# "mutation" would otherwise pass the text check). Anything else: 403.
		@ghWrite {
			not method GET HEAD
			not {
				method POST
				path /graphql
			}
		}
		respond @ghWrite 403
		@ghMutation {
			method POST
			path /graphql
			expression `{http.request.body}.matches(r"(?i)mutation|\\u")`
		}
		respond @ghMutation 403

		reverse_proxy https://api.github.com {
			header_up Host api.github.com
			header_up Authorization "Bearer {env.GH_TOKEN}"
			header_up -Cookie
		}
	}

	handle_path /council/* {
		reverse_proxy {$COUNCIL_URL}
	}

	handle_path /guardians/* {
		reverse_proxy {$GUARDIANS_URL}
	}

	handle {
		root * "{$SITE_DIR}"
		file_server
	}
}
